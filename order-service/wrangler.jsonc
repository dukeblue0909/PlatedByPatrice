{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patrice-orders",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html", "**/chef-prep.js"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.platedbypatrice.com,https://platedbypatrice.com,https://dukeblue0909.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patrice-orders",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
